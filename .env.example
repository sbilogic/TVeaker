# TVeaker App Configuration
TVEAKER_ENV=development
TVEAKER_HOST=127.0.0.1
TVEAKER_PORT=8000
TVEAKER_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
TVEAKER_DATABASE_PATH=data/tveaker.db
TVEAKER_SYNC_INTERVAL_MINUTES=15
TVEAKER_LOG_LEVEL=INFO

# Trakt API Application Credentials
# Create a Trakt API app at https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here
TRAKT_REDIRECT_URI=http://127.0.0.1:8000/auth/trakt/callback
